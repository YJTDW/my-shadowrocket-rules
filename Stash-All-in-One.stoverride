# Stash Override (YAML)
# 企业级跨平台客户端与服务端标准配置 - Stash 通用终极覆写 (全面对齐 sing-box 架构)
# 支持任何机场 / 私有聚合订阅，全自动生成策略组并自动过滤流量信息节点。

name: "3.8.23 正式版"
desc: |-
  3.8.24｜海外 AI 域名全面扩展并排除国内 AI：补全 GitHub Copilot 全区 WebPubSub/Telemetry、Anthropic Datadog、Cursor S3 下载、Microsoft copilot.com 及 55 个纯海外 AI 平台与开发生态后缀，移除失效 observeit.net，同步 nameserver-policy 代理 DoH；保持 Meta/Google/YouTube/数字资产独立分组与安全 DNS。
author: YJTDW
homepage: "https://github.com/YJTDW/my-shadowrocket-rules"
date: "2026-11-13"
version: "3.8.24"

mode: rule
ipv6: true

tun:
  enable: true
  stack: mixed
  mtu: 1400
  auto-route: true
  strict-route: true

proxy-groups: #!replace
- name: 🚀节点选择
  type: select
  proxies: #!replace
  - ♻️自动选择
  - 🖐手动节点
- name: ♻️自动选择
  type: url-test
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
  url: http://cp.cloudflare.com/generate_204
  interval: 300
  tolerance: 30
  lazy: true
- name: 🖐手动节点
  type: select
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: 📺 YouTube
  type: select
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: 🌐 Google服务
  type: select
  proxies: #!replace
  - 🤖 AI平台
  - 🚀节点选择
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: 🤖 AI平台
  type: select
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: Meta
  type: select
  proxies: #!replace
  - 🚀节点选择
  - ♻️自动选择
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服

- name: 💰 数字资产
  type: select
  proxies:
  - DIRECT
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
dns: #!replace
  follow-rule: true
  enable: true
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  default-nameserver:
  - 223.5.5.5
  - 119.29.29.29
  proxy-server-nameserver:
  - 223.5.5.5
  - 119.29.29.29
  nameserver:
  - https://dns.alidns.com/dns-query
  - https://doh.pub/dns-query
  fallback:
  - https://dns.google/dns-query
  - https://cloudflare-dns.com/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
    - 240.0.0.0/4
  fake-ip-filter:
  - push.apple.com
  - "+.push.apple.com"
  - alipay.com
  - '*.alipay.com'
  - alipayobjects.com
  - '*.alipayobjects.com'
  - alipay.com.cn
  - '*.alipay.com.cn'
  - alipay.net
  - '*.alipay.net'
  - '+.lan'
  - '+.local'
  - '+.arpa'
  - time.*
  - ntp.*
  - +.pool.ntp.org
  - localhost
  - +.home.arpa
  - '+.apple.com'
  - '+.apple.co'
  - '+.appstore.com'
