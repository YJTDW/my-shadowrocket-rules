# Stash Override (YAML)
# 企业级跨平台客户端与服务端标准配置 - Stash 通用终极覆写 (全面对齐 sing-box 架构)
# 支持任何机场 / 私有聚合订阅，全自动生成策略组并自动过滤流量信息节点。

name: "3.8.1 正式版"
desc: |-
  3.8.1｜Stash 通用正式版
  【全面看齐 sing-box 架构与策略组规范】
  1. 通用策略组注入：全自动接管任意机场/私有订阅，自动排除信息节点。
  2. 5 个策略组：🤖 AI平台、📺 YouTube、🚀节点选择、♻️自动选择、🖐手动节点 (Apple 官方低延迟测速)。
  3. WebRTC 防护：拦截已列出的 STUN / TURN 探测 (UDP 3478-3481/19302/19305/5349)，精准放行 OpenAI LiveKit 官方语音。
  4. Fake-IP 域名透传：开启 198.18.0.1/16 虚拟地址池，国内域名按规则直连，Apple 推送独立代理；Fake-IP 配合分流，防泄露仍需设备实测。
  5. DNS 智能分流：阿里/腾讯 DoH 国内直连，Google/Cloudflare DoH 节点代理解析。
  6. QUIC 拦截：拦截 UDP 443，强制降级走高性能 TCP TLS 1.3 隧道。
author: YJTDW
homepage: "https://github.com/YJTDW/my-shadowrocket-rules"
date: "2026-09-19"
version: "3.8.1"

mode: rule
ipv6: false

tun:
  enable: true
  stack: mixed
  mtu: 1400
  auto-route: true
  strict-route: true

proxy-groups: #!replace
- name: 🚀节点选择
  type: select
  proxies: #!replace
  - ♻️自动选择
  - 🖐手动节点
- name: ♻️自动选择
  type: url-test
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
  url: http://www.apple.com/library/test/success.html
  interval: 900
  tolerance: 3
  lazy: true
- name: 🖐手动节点
  type: select
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: 📺 YouTube
  type: select
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: 🤖 AI平台
  type: select
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服

dns: #!replace
  follow-rule: true
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  default-nameserver:
  - 223.5.5.5
  - 119.29.29.29
  proxy-server-nameserver:
  - 223.5.5.5
  - 119.29.29.29
  nameserver:
  - https://dns.alidns.com/dns-query
  - https://doh.pub/dns-query
  fallback:
  - https://dns.google/dns-query
  - https://cloudflare-dns.com/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
    - 240.0.0.0/4
  fake-ip-filter:
  - push.apple.com
  - "*.push.apple.com"
  - alipay.com
  - '*.alipay.com'
  - alipayobjects.com
  - '*.alipayobjects.com'
  - alipay.com.cn
  - '*.alipay.com.cn'
  - alipay.net
  - '*.alipay.net'
  - '*.lan'
  - '*.local'
  - '*.arpa'
  - time.*
  - ntp.*
  - +.pool.ntp.org
  - localhost
  - +.home.arpa
  - '*.apple.com'
  - '*.apple.co'
  - '*.appstore.com'
  - '*.icloud.com'
  - '*.icloud-content.com'
  - '*.cdn-apple.com'
  - '*.mzstatic.com'
  - '*.aaplimg.com'
  - '*.swcdn.apple.com'
  - '*.me.com'
  - '*.apple-cloudkit.com'
  - '*.apple-livephotoskit.com'
  - '*.apple-mapkit.com'
  - '*.baichuan-ai.com'
  - '*.chatglm.cn'
  - '*.deepseek.com'
  - '*.deepseeksvc.com'
  - '*.doubao.com'
  - '*.doubaocdn.com'
  - '*.hailuoai.com'
  - '*.kimi.ai'
  - '*.kimi.com'
  - '*.minimax.chat'
  - '*.moonshot.ai'
  - '*.moonshot.cn'
  - '*.qwen.ai'
  - '*.sensechat.cn'
  - '*.sensetime.com'
  - '*.stepfun.com'
  - '*.yuewen.cn'
  - '*.zhipuai.cn'
  - captive.apple.com
  - '*.wechat.com'
  - '*.weixin.com'
  - '*.servicewechat.com'
  - '*.qq.com'
  - '*.qpic.cn'
  - '*.qlogo.cn'
  - '*.gtimg.com'
  - '*.cn'
  - '*.xn--fiqs8s'
  - '*.xn--fiqz9s'
  - '*.xn--55qx5d'
  - '*.xn--io0a7i'
  - '*.xn--zfr164b'
  - '*.xn--55qw42g'
  - '*.qihangjiaoyu.com'
  - '*.polyv.net'
  - '*.polyv.cn'
  - '*.alicdn.com'
  - '*.msftncsi.com'
  - '*.msftconnecttest.com'
  nameserver-policy:
    "+.ads-twitter.com":
    - https://dns.google/dns-query
    - https://cloudflare-dns.com/dns-query
