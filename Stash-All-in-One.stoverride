# Stash Override (YAML)
# Universal Stash DNS/routing/group override for node-only subscriptions.
# It does not contain subscription URLs, nodes, credentials, or private endpoints.

name: "通用正式版"
desc: |-
  自动载入订阅中的全部节点，统一生成“🚀节点选择”“♻️自动选择”和“📺 YouTube”三个策略组。
  YouTube 域名解析与实际连接共同跟随“📺 YouTube”，避免 DNS 出口与视频出口不一致。
  保留轻量 DNS、IPv6/QUIC 防泄露、国内直连、Apple 分流与广告拦截。
  Google 其他服务、OpenAI/ChatGPT/Codex、Twitter/X 与 ChatGPT 高级语音 UDP 3478 跟随“🚀节点选择”。
  国内音视频流媒体 (企航/保利威/微信) 绝对置顶直连，取流分流最优。
  启用选择性 Fake IP：普通代理域名使用 Fake IP，局域网、Apple、微信、STUN/TURN 与泄露检测域名保留真实 IP。
  DNS 等价同步电脑端：国内解析直连，境外解析经当前节点，兼顾 CDN 与泄露防护。
  完整替换订阅自带 DNS，避免遗留 fallback、Fake IP 模式或过滤条件引发解析死循环。
  与电脑端同步 Apple、OpenAI、泄露检测、WebRTC/STUN、IPv6 与 QUIC 的等价行为。
author: YJTDW
homepage: "https://github.com/YJTDW/my-shadowrocket-rules"
date: "2026-09-03"
version: "3.4.3"

mode: rule
ipv6: false

tun:
  enable: true
  stack: mixed
  mtu: 1400
  auto-route: true
  strict-route: true

# 订阅只负责提供节点。通用覆写自动装载全部节点并完整替换订阅自带策略组。
proxy-groups: #!replace
  # 先声明自动组，确保后续手动组引用时 Stash 已经识别该策略组。
  - name: "♻️自动选择"
    type: url-test
    include-all: true
    interval: 3600
    lazy: true

  - name: "🚀节点选择"
    type: select
    proxies:
      - "♻️自动选择"
    include-all: true

  - name: "📺 YouTube"
    type: select
    proxies:
      - "🚀节点选择"
    include-all: true

dns: #!replace
  enable: true
  ipv6: false
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  proxy-server-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  nameserver: #!replace
    - "https://dns.alidns.com/dns-query"
    - "https://doh.pub/dns-query"
  # Do not inherit UDP fallbacks such as 1.1.1.1:53 or 8.8.8.8:53 from subscriptions.
  # Keep fallback encrypted over HTTPS so it can traverse normal and chained TCP proxies.
  fallback: #!replace
    - "https://dns.google/dns-query"
    - "https://cloudflare-dns.com/dns-query"
  nameserver-policy: #!replace
    # Apple 普通服务优先国内解析，避免被境外总分类提前接管。
    "geosite:apple":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.apple.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.icloud.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.icloud-content.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.appstore.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.cdn-apple.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.mzstatic.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.aaplimg.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.me.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    # YouTube 使用独立的 IP 形式 DoH。其连接在规则区绑定到“📺 YouTube”，
    # 因而解析出口与网页、视频 CDN 出口保持一致。
    "geosite:youtube": "https://1.1.1.1/dns-query"
    "+.youtube.com": "https://1.1.1.1/dns-query"
    "+.youtube-nocookie.com": "https://1.1.1.1/dns-query"
    "+.youtubeeducation.com": "https://1.1.1.1/dns-query"
    "+.youtu.be": "https://1.1.1.1/dns-query"
    "+.yt.be": "https://1.1.1.1/dns-query"
    "+.ytimg.com": "https://1.1.1.1/dns-query"
    "+.googlevideo.com": "https://1.1.1.1/dns-query"
    "youtube.googleapis.com": "https://1.1.1.1/dns-query"
    "youtubei.googleapis.com": "https://1.1.1.1/dns-query"
    "yt3.ggpht.com": "https://1.1.1.1/dns-query"

    "geosite:geolocation-!cn":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "geosite:gfw":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"

    "geosite:google":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "geosite:openai":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.google.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.googleapis.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.googleusercontent.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.gstatic.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.openai.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.chatgpt.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.oaistatic.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.oaiusercontent.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.livekit.cloud":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
  follow-rule: true
  skip-cert-verify: false
  fake-ip-filter: #!replace
    # 局域网、系统连通性与 Apple/APNs 保留真实 IP。
    - "localhost"
    - "+.lan"
    - "+.local"
    - "+.home.arpa"
    - "captive.apple.com"
    - "+.push.apple.com"
    - "+.apple.com"
    - "+.apple.co"
    - "+.appstore.com"
    - "+.icloud.com"
    - "+.icloud-content.com"
    - "+.cdn-apple.com"
    - "+.mzstatic.com"
    - "+.aaplimg.com"
    - "+.me.com"
    - "+.apple-cloudkit.com"
    - "+.apple-livephotoskit.com"
    - "+.apple-mapkit.com"

    # 微信、QQ 与腾讯 CDN 直连域名保留真实 IP。
    - "+.wechat.com"
    - "+.weixin.com"
    - "+.servicewechat.com"
    - "+.qq.com"
    - "+.qpic.cn"
    - "+.qlogo.cn"
    - "+.gtimg.com"

    # STUN/TURN 与实时语音需要真实目标地址。
    - "+.stun.*.*"
    - "+.stun.*.*.*"
    - "+.stun.*.*.*.*"
    - "+.stun.*.*.*.*.*"
    - "+.turn.*.*"
    - "+.turn.*.*.*"
    - "+.turn.*.*.*.*"
    - "stun.l.google.com"
    - "stun1.l.google.com"
    - "stun2.l.google.com"
    - "stun3.l.google.com"
    - "stun4.l.google.com"
    - "stun.cloudflare.com"
    - "+.livekit.cloud"

    # 泄露检测站保留真实 DNS 响应，避免 Fake IP 干扰检测页面。
    - "+.browserleaks.com"
    - "+.browserleaks.net"
    - "+.browserleaks.org"
    - "+.ipleak.net"
    - "+.dnsleaktest.com"
    - "+.whoer.net"
    - "+.iphey.com"
    - "+.ip8.com"
    - "+.whatismyipaddress.com"
    - "+.check.place"

# Block QUIC so HTTP/3 falls back to TCP and follows the high-speed XTLS proxy path.
script:
  shortcuts:
    merged-quic: "network == 'udp' and dst_port == 443"
    webrtc-ports: "network == 'udp' and dst_port >= 3478 and dst_port <= 3481"
    webrtc-turn-tls: "network == 'udp' and dst_port == 5349"

rules: #!replace
  # DNS 出口：国内 DoH 直连，普通境外 DoH 跟随总节点，YouTube 专用 DoH 跟随 YouTube 组。
  - "DOMAIN,dns.alidns.com,DIRECT"
  - "DOMAIN,doh.pub,DIRECT"
  - "IP-CIDR,1.1.1.1/32,📺 YouTube,no-resolve"
  - "DOMAIN,dns.google,🚀节点选择"
  - "DOMAIN,cloudflare-dns.com,🚀节点选择"

  # 0. 严格阻断 IPv6 旁路，与电脑端规则保持一致
  - "IP-CIDR6,::/0,REJECT,no-resolve"

  # 1. 局域网与内网 UDP/TCP 绝对直连
  - "DOMAIN-SUFFIX,local,DIRECT"
  - "DOMAIN-SUFFIX,localhost,DIRECT"
  - "DOMAIN-SUFFIX,lan,DIRECT"
  - "DOMAIN-SUFFIX,home.arpa,DIRECT"
  - "DOMAIN,captive.apple.com,DIRECT"
  - "IP-CIDR,0.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve"
  - "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve"
  - "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,224.0.0.0/4,DIRECT,no-resolve"

  # 2. ChatGPT 官方高级实时语音 UDP 3478 专线 (Article 9247338 官方网段放行)
  - "DOMAIN-SUFFIX,livekit.cloud,🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,102.37.57.54/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,13.71.25.29/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,135.220.40.201/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,172.203.39.49/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,172.207.173.200/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,172.214.226.198/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,191.233.251.27/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,20.162.96.163/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,20.168.48.117/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,20.184.36.134/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,20.203.144.245/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,20.74.221.21/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,4.151.200.38/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,4.155.146.196/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,4.197.172.116/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,4.217.235.100/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,4.245.198.13/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,40.118.236.137/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,51.4.112.173/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,52.143.181.161/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,68.155.152.41/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,72.146.20.246/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,74.248.148.7/32,no-resolve)),🚀节点选择"

  # 3. WebRTC STUN 探测通道 (保障 WebRTC 正常工作且 0 泄露)
  - "PROTOCOL,STUN,🚀节点选择"
  - "DOMAIN-KEYWORD,stun,🚀节点选择"
  - "DOMAIN-KEYWORD,turn,🚀节点选择"
  - "DOMAIN-SUFFIX,stun.l.google.com,🚀节点选择"
  - "DOMAIN-SUFFIX,stun1.l.google.com,🚀节点选择"
  - "DOMAIN-SUFFIX,stun2.l.google.com,🚀节点选择"
  - "DOMAIN-SUFFIX,stun3.l.google.com,🚀节点选择"
  - "DOMAIN-SUFFIX,stun4.l.google.com,🚀节点选择"
  - "DOMAIN-SUFFIX,stun.cloudflare.com,🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,19302)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,19305)),🚀节点选择"
  - "SCRIPT,webrtc-ports,🚀节点选择"
  - "SCRIPT,webrtc-turn-tls,🚀节点选择"

  # 4. Apple 双轨分流 (隐私中继走节点，下载与系统服务极速直连)
  - "DOMAIN-SUFFIX,apple-relay.apple.com,🚀节点选择"
  - "DOMAIN-SUFFIX,apple-relay.cloudflare.com,🚀节点选择"
  - "DOMAIN-SUFFIX,apple-relay.akamaized.net,🚀节点选择"
  - "DOMAIN-SUFFIX,apple.com,DIRECT"
  - "DOMAIN-SUFFIX,apple.co,DIRECT"
  - "DOMAIN-SUFFIX,appstore.com,DIRECT"
  - "DOMAIN-SUFFIX,icloud.com,DIRECT"
  - "DOMAIN-SUFFIX,icloud-content.com,DIRECT"
  - "DOMAIN-SUFFIX,itunes.apple.com,DIRECT"
  - "DOMAIN-SUFFIX,apps.apple.com,DIRECT"
  - "DOMAIN-SUFFIX,cdn-apple.com,DIRECT"
  - "DOMAIN-SUFFIX,mzstatic.com,DIRECT"
  - "DOMAIN-SUFFIX,aaplimg.com,DIRECT"
  - "DOMAIN-SUFFIX,swcdn.apple.com,DIRECT"
  - "DOMAIN-SUFFIX,me.com,DIRECT"
  - "DOMAIN-SUFFIX,apple-cloudkit.com,DIRECT"
  - "DOMAIN-SUFFIX,apple-livephotoskit.com,DIRECT"
  - "DOMAIN-SUFFIX,apple-mapkit.com,DIRECT"
  - "GEOSITE,apple,DIRECT"

  # 境外检测与工具域名跟随节点，避免测试站误走直连
  - "DOMAIN-KEYWORD,browserleaks,🚀节点选择"
  - "DOMAIN-SUFFIX,browserleaks.com,🚀节点选择"
  - "DOMAIN-SUFFIX,ip.net.coffee,🚀节点选择"
  - "DOMAIN-SUFFIX,ipleak.net,🚀节点选择"

  # 5. Twitter / X 全家桶置顶放行 (免疫广告误杀)
  - "GEOSITE,twitter,🚀节点选择"
  - "DOMAIN-KEYWORD,twitter,🚀节点选择"
  - "DOMAIN-KEYWORD,x.com,🚀节点选择"
  - "DOMAIN-SUFFIX,x.com,🚀节点选择"
  - "DOMAIN-SUFFIX,twitter.com,🚀节点选择"
  - "DOMAIN-SUFFIX,twimg.com,🚀节点选择"
  - "DOMAIN-SUFFIX,t.co,🚀节点选择"
  - "DOMAIN-SUFFIX,pscp.tv,🚀节点选择"
  - "DOMAIN-SUFFIX,periscope.tv,🚀节点选择"

  # 6. YouTube 独立分流必须位于 Google 通用规则之前。
  - "GEOSITE,youtube,📺 YouTube"
  - "DOMAIN-KEYWORD,youtube,📺 YouTube"
  - "DOMAIN-SUFFIX,youtube.com,📺 YouTube"
  - "DOMAIN-SUFFIX,youtube-nocookie.com,📺 YouTube"
  - "DOMAIN-SUFFIX,youtubeeducation.com,📺 YouTube"
  - "DOMAIN-SUFFIX,youtu.be,📺 YouTube"
  - "DOMAIN-SUFFIX,yt.be,📺 YouTube"
  - "DOMAIN-SUFFIX,ytimg.com,📺 YouTube"
  - "DOMAIN-SUFFIX,googlevideo.com,📺 YouTube"
  - "DOMAIN,youtube.googleapis.com,📺 YouTube"
  - "DOMAIN,youtubei.googleapis.com,📺 YouTube"
  - "DOMAIN,yt3.ggpht.com,📺 YouTube"

  # 7. Google 其他服务走总节点
  - "GEOSITE,google,🚀节点选择"
  - "DOMAIN-KEYWORD,google,🚀节点选择"
  - "DOMAIN-SUFFIX,1e100.net,🚀节点选择"
  - "DOMAIN-SUFFIX,android.com,🚀节点选择"
  - "DOMAIN-SUFFIX,appspot.com,🚀节点选择"
  - "DOMAIN-SUFFIX,blogger.com,🚀节点选择"
  - "DOMAIN-SUFFIX,blogspot.com,🚀节点选择"
  - "DOMAIN-SUFFIX,firebaseapp.com,🚀节点选择"
  - "DOMAIN-SUFFIX,firebaseio.com,🚀节点选择"
  - "DOMAIN-SUFFIX,ggpht.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gstatic.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gvt0.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gvt1.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gvt2.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gvt3.com,🚀节点选择"
  - "DOMAIN-SUFFIX,kaggle.com,🚀节点选择"
  - "DOMAIN-SUFFIX,recaptcha.net,🚀节点选择"
  - "DOMAIN-SUFFIX,waze.com,🚀节点选择"
  - "DOMAIN-SUFFIX,widevine.com,🚀节点选择"
