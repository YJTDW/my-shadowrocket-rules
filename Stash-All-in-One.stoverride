  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,74.248.148.7/32,no-resolve)),🚀节点选择"

  # 3. WebRTC STUN 探测通道 (保障 WebRTC 正常工作且 0 泄露)
  - "PROTOCOL,STUN,🚀节点选择"
  - "DOMAIN-KEYWORD,stun,🚀节点选择"
  - "DOMAIN-KEYWORD,turn,🚀节点选择"
  - "DOMAIN-SUFFIX,stun.l.google.com,🚀节点选择"
