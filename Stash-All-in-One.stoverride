# Stash Override (YAML)
# Lightweight Stash DNS/routing override rebuilt from the known-working v3.1.0 base.
# It does not contain subscription URLs, nodes, or proxy groups.

name: "正式版"
desc: |-
  保留轻量 DNS、IPv6/QUIC 防泄露、国内直连、Apple 分流与广告拦截。
  Google、OpenAI/ChatGPT/Codex、Twitter/X 与 ChatGPT 高级语音 UDP 3478 强制跟随“🚀节点选择”。
  国内音视频流媒体 (企航/保利威/微信) 绝对置顶直连，取流分流最优。
  关闭 Fake IP：所有域名返回真实 IP，不使用电脑端 Mihomo 专属字段。
  DNS 等价同步电脑端：国内解析直连，境外解析经当前节点，兼顾 CDN 与泄露防护。
  与电脑端同步 Apple、OpenAI、泄露检测、WebRTC/STUN、IPv6 与 QUIC 的等价行为。
author: YJTDW
homepage: "https://github.com/YJTDW/my-shadowrocket-rules"
date: "2026-08-21"
version: "3.2.5"

mode: rule
ipv6: false

dns:
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  proxy-server-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  nameserver: #!replace
    - "https://dns.alidns.com/dns-query"
    - "https://doh.pub/dns-query"
  nameserver-policy: #!replace
    # Apple 普通服务优先国内解析，避免被境外总分类提前接管。
    "geosite:apple":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.apple.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.icloud.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.icloud-content.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.appstore.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.cdn-apple.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.mzstatic.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.aaplimg.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.me.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "geosite:geolocation-!cn":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "geosite:gfw":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "geosite:google":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "geosite:openai":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.google.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.googleapis.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.googleusercontent.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.googlevideo.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.gstatic.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.youtube.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.openai.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.chatgpt.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.oaistatic.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.oaiusercontent.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.livekit.cloud":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
  follow-rule: true
  skip-cert-verify: false
  fake-ip-filter: #!replace
    - "*"

# Block QUIC so HTTP/3 falls back to TCP and follows the high-speed XTLS proxy path.
script:
  shortcuts:
    merged-quic: "network == 'udp' and dst_port == 443"
    webrtc-ports: "network == 'udp' and dst_port >= 3478 and dst_port <= 3481"

rules: #!replace
  # DNS 出口与电脑端等价：国内 DoH 直连，境外 DoH 跟随当前节点。
  - "DOMAIN,dns.alidns.com,DIRECT"
  - "DOMAIN,doh.pub,DIRECT"
  - "DOMAIN,dns.google,🚀节点选择"
  - "DOMAIN,cloudflare-dns.com,🚀节点选择"

  # 0. 严格阻断 IPv6 旁路，与电脑端规则保持一致
  - "IP-CIDR6,::/0,REJECT,no-resolve"

  # 1. 局域网与内网 UDP/TCP 绝对直连
  - "DOMAIN-SUFFIX,local,DIRECT"
  - "DOMAIN-SUFFIX,localhost,DIRECT"
  - "DOMAIN-SUFFIX,lan,DIRECT"
  - "DOMAIN-SUFFIX,home.arpa,DIRECT"
  - "DOMAIN,captive.apple.com,DIRECT"
  - "IP-CIDR,0.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve"
  - "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve"
  - "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,224.0.0.0/4,DIRECT,no-resolve"

  # 2. ChatGPT 官方高级实时语音 UDP 3478 专线 (Article 9247338 官方网段放行)
  - "DOMAIN-SUFFIX,livekit.cloud,🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,102.37.57.54/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,13.71.25.29/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,135.220.40.201/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,172.203.39.49/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,172.207.173.200/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,172.214.226.198/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,191.233.251.27/32,no-resolve)),🚀节点选择"
  - "AND,((NETWORK,UDP),(DST-PORT,3478),(IP-CIDR,20.162.96.163/32,no-resolve)),🚀节点选择"
