name: "3.9.5 正式版"
desc: |-
  3.9.5｜T3 Code 全系纳入 AI 平台，补齐微信小程序云托管/网关/直播/COS 直连；全面适配 Stash 5.0 覆写分类管理（category）与参数配置（arguments）；微信与腾讯生态全场景极速直连绝对置顶（涵盖微信支付、小程序、视频号、腾讯多媒体/对象存储 CDN、客户端进程与 AS45090 直连免解析，并加入嗅探豁免防 MMTLS 首包阻塞）；所有手动策略组均在同一层列出原有策略入口与订阅节点，自动选择使用同一订阅测速；清理 83 条重复 Fake-IP 过滤项与 68 条冗余 TCP 重复直连规则，按优先级重构 12 大规则分区。
author: "YJTDW"
date: "2026-11-24"
version: "3.9.5"
category: "核心分流与安全"
arguments-version: 1
arguments:
  node_subscription:
    type: input
    title: "Stash 节点订阅地址"
    description: "填入当前 Stash / Clash YAML 节点订阅的 HTTPS 地址。"
    required: true
  wechat_fast_direct:
    type: switch
    title: "微信与腾讯生态极速直连"
    description: "置顶直连微信/微信支付/小程序/视频号/腾讯云 CDN 与 AS45090，配合腾讯 DNSPod + 阿里双 DoH 真实 IP 解析"
    default: true
mode: rule
log-level: info
ipv6: true
unified-delay: true
tcp-concurrent: true
find-process-mode: strict
global-client-fingerprint: chrome
profile:
  store-selected: true
  store-fake-ip: true
proxy-groups: #!replace
- name: 🚀节点选择
  type: select
  proxies: #!replace
  - ♻️自动选择
  use:
  - digital-assets-subscription
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: ♻️自动选择
  type: url-test
  use:
  - digital-assets-subscription
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
  url: http://www.apple.com/library/test/success.html
  interval: 3600
  lazy: true
  tolerance: 3
- name: 📺 YouTube
  type: select
  proxies: #!replace
  - 🚀节点选择
  - ♻️自动选择
  use:
  - digital-assets-subscription
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: 🌐 Google服务
  type: select
  proxies: #!replace
  - 🤖 AI平台
  - 🚀节点选择
  - ♻️自动选择
  use:
  - digital-assets-subscription
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: 🤖 AI平台
  type: select
  proxies: #!replace
  - 🚀节点选择
  - ♻️自动选择
  use:
  - digital-assets-subscription
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: Meta
  type: select
  proxies: #!replace
  - 🚀节点选择
  - ♻️自动选择
  use:
  - digital-assets-subscription
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: 💰 数字资产
  type: select
  proxies:
  - DIRECT
  - 🚀节点选择
  - ♻️自动选择
  use:
  - digital-assets-subscription
proxy-providers:
  digital-assets-subscription:
    url: '${args.node_subscription}'
    interval: 3600
dns:
  enable: true
  ipv6: true
  prefer-h3: false
  use-hosts: true
  use-system-hosts: true
  respect-rules: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: blacklist
  fake-ip-filter:
  - localhost
  - +.lan
  - +.local
  - +.home.arpa
  - rule-set:aligned-tencent-domain
  - +.wechat.com
  - +.weixin.com
