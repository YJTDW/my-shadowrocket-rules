script:
  shortcuts:
    merged-quic: "network == 'udp' and dst_port == 443"
    webrtc-ports: "network == 'udp' and dst_port >= 3478 and dst_port <= 3481"
    webrtc-turn-tls: "network == 'udp' and dst_port == 5349"

