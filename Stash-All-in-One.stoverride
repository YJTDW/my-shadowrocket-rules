# Stash Override (YAML)
# Mobile-optimized DNS leak prevention and routing override.
# It does not contain subscription URLs, nodes, or proxy groups.

name: "三合一防泄露分流（手机优化版）"
desc: |-
  适用于直接导入 Stash 的 Clash/Mihomo 订阅，不依赖 Sub-Store。
  保留国内常用软件直连、Apple 分流和广告拦截；Google/OpenAI 全生态统一跟随“🚀节点选择”。
  对启航教育 iPhone/iPad、课程视频与静态资源增加明确的国内直连兜底。
  不加载大型远程规则集，减少手机内存、后台下载、DNS 并发与电量消耗。
  要求当前订阅已提供“🚀节点选择”，且不要在该组内选择 DIRECT。
author: YJTDW
homepage: "https://github.com/YJTDW/my-shadowrocket-rules"
date: "2026-08-13"
version: "3.2.1"

mode: rule
ipv6: false

# 国内日常解析保留两个加密 DNS；Stash 官方不建议超过两个，以免增加功耗。
# Google/OpenAI 使用单个 Cloudflare DoH，并通过 follow-rule 跟随“🚀节点选择”。
# 使用 IP 形式的 DoH 地址可避免代理服务器和 DNS 服务器之间发生递归解析。
dns:
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  nameserver: #!replace
    - "https://dns.alidns.com/dns-query"
    - "https://doh.pub/dns-query"
  follow-rule: true
  skip-cert-verify: false
  nameserver-policy: #!replace
    # Google：GEOSITE 主规则加少量关键兜底，统一使用境外 DNS。
    "geosite:google": "https://1.1.1.1/dns-query"
    "+.google.com": "https://1.1.1.1/dns-query"
    "+.google.cn": "https://1.1.1.1/dns-query"
    "+.googleapis.com": "https://1.1.1.1/dns-query"
    "+.googleusercontent.com": "https://1.1.1.1/dns-query"
    "+.googlevideo.com": "https://1.1.1.1/dns-query"
    "+.gstatic.com": "https://1.1.1.1/dns-query"
    "+.youtube.com": "https://1.1.1.1/dns-query"
    "+.ytimg.com": "https://1.1.1.1/dns-query"
    "+.1e100.net": "https://1.1.1.1/dns-query"
    "+.recaptcha.net": "https://1.1.1.1/dns-query"

    # OpenAI / ChatGPT / Codex 及其登录、实时通道和遥测缺口。
    "geosite:openai": "https://1.1.1.1/dns-query"
    "+.openai.com": "https://1.1.1.1/dns-query"
    "+.chatgpt.com": "https://1.1.1.1/dns-query"
    "+.chatgpt.site": "https://1.1.1.1/dns-query"
    "+.chat.com": "https://1.1.1.1/dns-query"
    "+.sora.com": "https://1.1.1.1/dns-query"
    "+.oaistatic.com": "https://1.1.1.1/dns-query"
    "+.oaistatsig.com": "https://1.1.1.1/dns-query"
    "+.oaiusercontent.com": "https://1.1.1.1/dns-query"
    "+.crixet.com": "https://1.1.1.1/dns-query"
    "+.openai.com.cdn.cloudflare.net": "https://1.1.1.1/dns-query"
    "openaiapi-site.azureedge.net": "https://1.1.1.1/dns-query"
    "openaiassets.blob.core.windows.net": "https://1.1.1.1/dns-query"
    "openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net": "https://1.1.1.1/dns-query"
    "openaicom.imgix.net": "https://1.1.1.1/dns-query"
    "openaicomproductionae4b.blob.core.windows.net": "https://1.1.1.1/dns-query"
    "production-openaicom-storage.azureedge.net": "https://1.1.1.1/dns-query"
    "+.livekit.cloud": "https://1.1.1.1/dns-query"
    "+.webpubsub.azure.com": "https://1.1.1.1/dns-query"
    "client-api.arkoselabs.com": "https://1.1.1.1/dns-query"
    "openai-api.arkoselabs.com": "https://1.1.1.1/dns-query"
    "challenges.cloudflare.com": "https://1.1.1.1/dns-query"
    "cdn.openaimerge.com": "https://1.1.1.1/dns-query"
    "cdn.workos.com": "https://1.1.1.1/dns-query"
    "forwarder.workos.com": "https://1.1.1.1/dns-query"
    "images.workoscdn.com": "https://1.1.1.1/dns-query"
    "setup.workos.com": "https://1.1.1.1/dns-query"
    "workos.imgix.net": "https://1.1.1.1/dns-query"
    "o207216.ingest.sentry.io": "https://1.1.1.1/dns-query"
    "o33249.ingest.sentry.io": "https://1.1.1.1/dns-query"
    "o33249.ingest.us.sentry.io": "https://1.1.1.1/dns-query"
    "+.browser-intake-datadoghq.com": "https://1.1.1.1/dns-query"

    # 启航教育 iPhone/iPad、官网和课程视频明确使用国内加密 DNS。
    "+.iqihang.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.iqihangedu.com.cn":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.qihang.com.cn":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.vipqihang.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.polyv.net":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.videocc.net":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.alicdn.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "iqh-zt.oss-cn-beijing.aliyuncs.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"

    # 其余国内域名继续使用国内加密 DNS，维持国内 CDN 与低延迟。
    "geosite:cn":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"

  fake-ip-filter: #!replace
    - "*.lan"
    - "+.local"
    - "+.localhost"
    - "+.home.arpa"
    - "captive.apple.com"
    - "time.*.com"
    - "time.*.gov"
    - "time.*.edu.cn"
    - "time.*.apple.com"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"

# 只拒绝没有提前命中 Google/OpenAI/国内规则的其他 QUIC，应用会回退 TCP。
script:
  shortcuts:
    merged-quic: "network == 'udp' and dst_port == 443"

# 清空订阅携带但已不再使用的大型远程规则源，避免手机后台下载和常驻内存。
rule-providers: #!replace
  {}

# 完整替换订阅规则，保留订阅节点和策略组不变。
rules: #!replace
  # DNS 服务器自身的连接必须先确定出口，避免 follow-rule 递归。
  - "DOMAIN,dns.alidns.com,DIRECT"
  - "DOMAIN,doh.pub,DIRECT"
  - "IP-CIDR,1.1.1.1/32,🚀节点选择,no-resolve"

  # 局域网和保留地址直连。
  - "DOMAIN-SUFFIX,local,DIRECT"
  - "DOMAIN-SUFFIX,localhost,DIRECT"
  - "DOMAIN-SUFFIX,lan,DIRECT"
  - "DOMAIN-SUFFIX,home.arpa,DIRECT"
  - "DOMAIN,captive.apple.com,DIRECT"
  - "IP-CIDR,0.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve"
  - "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve"
  - "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,224.0.0.0/4,DIRECT,no-resolve"

  # Apple Private Relay 先代理，其余 Apple 服务保持直连。
  - "DOMAIN-SUFFIX,apple-relay.apple.com,🚀节点选择"
  - "DOMAIN-SUFFIX,apple-relay.cloudflare.com,🚀节点选择"
  - "DOMAIN-SUFFIX,apple-relay.akamaized.net,🚀节点选择"
  - "DOMAIN-SUFFIX,apple.com,DIRECT"
  - "DOMAIN-SUFFIX,icloud.com,DIRECT"
  - "DOMAIN-SUFFIX,cdn-apple.com,DIRECT"
  - "DOMAIN-SUFFIX,mzstatic.com,DIRECT"

  # Google 全生态必须在广告和国内规则之前命中，包含 Google 中国域名。
  - "GEOSITE,google,🚀节点选择"
  - "DOMAIN-KEYWORD,google,🚀节点选择"
  - "DOMAIN-KEYWORD,youtube,🚀节点选择"
  - "DOMAIN-SUFFIX,1e100.net,🚀节点选择"
  - "DOMAIN-SUFFIX,googleapis.com,🚀节点选择"
  - "DOMAIN-SUFFIX,googleusercontent.com,🚀节点选择"
  - "DOMAIN-SUFFIX,googlevideo.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gstatic.com,🚀节点选择"
  - "DOMAIN-SUFFIX,recaptcha.net,🚀节点选择"
  - "DOMAIN-SUFFIX,youtu.be,🚀节点选择"
  - "DOMAIN-SUFFIX,ytimg.com,🚀节点选择"

  # OpenAI / ChatGPT / Codex 主域、API、静态文件、实时通道和高级语音。
  - "GEOSITE,openai,🚀节点选择"
  - "DOMAIN-SUFFIX,livekit.cloud,🚀节点选择"

  # 登录验证、企业身份链、共享 CDN 与遥测的精确缺口。
  - "DOMAIN,client-api.arkoselabs.com,🚀节点选择"
  - "DOMAIN,openai-api.arkoselabs.com,🚀节点选择"
  - "DOMAIN,challenges.cloudflare.com,🚀节点选择"
  - "DOMAIN,cdn.openaimerge.com,🚀节点选择"
  - "DOMAIN,cdn.workos.com,🚀节点选择"
  - "DOMAIN,forwarder.workos.com,🚀节点选择"
  - "DOMAIN,images.workoscdn.com,🚀节点选择"
  - "DOMAIN,setup.workos.com,🚀节点选择"
  - "DOMAIN,workos.imgix.net,🚀节点选择"
  - "DOMAIN-SUFFIX,webpubsub.azure.com,🚀节点选择"
  - "DOMAIN-SUFFIX,browser-intake-datadoghq.com,🚀节点选择"
  - "DOMAIN-REGEX,^o(207216|33249)\\.ingest(\\.[a-z0-9-]+)?\\.sentry\\.io$,🚀节点选择"

  # 启航教育 iPhone/iPad、官网、课件、直播/录播与静态资源明确直连。
  # 这些规则必须位于广告拦截和通用 QUIC/UDP 规则之前。
  - "DOMAIN-SUFFIX,iqihang.com,DIRECT"
  - "DOMAIN-SUFFIX,iqihangedu.com.cn,DIRECT"
  - "DOMAIN-SUFFIX,qihang.com.cn,DIRECT"
  - "DOMAIN-SUFFIX,vipqihang.com,DIRECT"
  - "DOMAIN-SUFFIX,polyv.net,DIRECT"
  - "DOMAIN-SUFFIX,videocc.net,DIRECT"
  - "DOMAIN-SUFFIX,alicdn.com,DIRECT"
  - "DOMAIN,iqh-zt.oss-cn-beijing.aliyuncs.com,DIRECT"

  # 国内常用软件的域名优先直连，避免被广告集合误伤。
  - "DOMAIN-SUFFIX,cn,DIRECT"
  - "DOMAIN-SUFFIX,xn--fiqs8s,DIRECT"
  - "DOMAIN-SUFFIX,xn--fiqz9s,DIRECT"
  - "DOMAIN-SUFFIX,xn--55qx5d,DIRECT"
  - "DOMAIN-SUFFIX,xn--io0a7i,DIRECT"
  - "DOMAIN-SUFFIX,xn--zfr164b,DIRECT"
  - "DOMAIN-SUFFIX,xn--55qw42g,DIRECT"
  - "GEOSITE,cn,DIRECT"

  # Google/OpenAI 和国内核心域名均已在上方分流；其余广告继续拦截。
  - "GEOSITE,category-ads-all,REJECT"

  # 为尚未被 GEOSITE 收录的国内 .com/App 接口按中国大陆 IP 兜底直连。
  - "GEOIP,CN,DIRECT"

  # 剩余境外 QUIC 拒绝并回退 TCP；其他 UDP 必须走当前代理节点。
  - "SCRIPT,merged-quic,REJECT,no-track"
  - "NETWORK,udp,🚀节点选择"

  # 其他未分类流量统一跟随当前正常或链式出口。
  - "MATCH,🚀节点选择"
