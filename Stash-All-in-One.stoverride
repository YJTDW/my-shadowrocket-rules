# Stash Override (YAML)
# 企业级跨平台客户端与服务端标准配置 - Stash 通用终极覆写 (全面对齐 sing-box 架构)
# 支持任何机场 / 私有聚合订阅，全自动生成策略组并自动过滤流量信息节点。

name: "3.8.14 正式版"
desc: |-
  3.8.14｜DNS fake-ip-filter 与 nameserver-policy 同步接入同源国内域名集并将单层 *. 升级为多层 +. 后缀匹配，确保国内多级子域与直连服务直接返回真实 IP（对齐 sing-box）；保留指定服务例外与既有防护。
author: YJTDW
homepage: "https://github.com/YJTDW/my-shadowrocket-rules"
date: "2026-10-13"
version: "3.8.14"

mode: rule
ipv6: false

tun:
  enable: true
  stack: mixed
  mtu: 1400
  auto-route: true
  strict-route: true

proxy-groups: #!replace
- name: 🚀节点选择
  type: select
  proxies: #!replace
  - ♻️自动选择
  - 🖐手动节点
- name: ♻️自动选择
  type: url-test
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
  url: http://www.apple.com/library/test/success.html
  interval: 900
  tolerance: 3
  lazy: true
- name: 🖐手动节点
  type: select
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: 📺 YouTube
  type: select
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服
- name: 🤖 AI平台
  type: select
  include-all: true
  exclude-filter: (?i)剩余|流量|套餐|到期|重置|官网|客服

dns: #!replace
  follow-rule: true
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  default-nameserver:
  - 223.5.5.5
  - 119.29.29.29
  proxy-server-nameserver:
  - 223.5.5.5
  - 119.29.29.29
  nameserver:
  - https://dns.alidns.com/dns-query
  - https://doh.pub/dns-query
  fallback:
  - https://dns.google/dns-query
  - https://cloudflare-dns.com/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
    - 240.0.0.0/4
  fake-ip-filter:
  - push.apple.com
  - "+.push.apple.com"
  - alipay.com
  - '*.alipay.com'
  - alipayobjects.com
  - '*.alipayobjects.com'
  - alipay.com.cn
  - '*.alipay.com.cn'
  - alipay.net
  - '*.alipay.net'
  - '+.lan'
  - '+.local'
  - '+.arpa'
  - time.*
  - ntp.*
  - +.pool.ntp.org
  - localhost
  - +.home.arpa
  - '+.apple.com'
  - '+.apple.co'
  - '+.appstore.com'
  - '+.icloud.com'
  - '+.icloud-content.com'
  - '+.cdn-apple.com'
  - '*.mzstatic.com'
  - '+.aaplimg.com'
  - '+.swcdn.apple.com'
