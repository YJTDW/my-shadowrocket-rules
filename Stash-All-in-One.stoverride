# Stash Override (YAML)
# 苹果全家桶 100% 绝对纯直连 + Google/OpenAI 强制节点版 (v4.3.0)

name: "正式版"
desc: |-
  苹果全家桶 100% 绝对纯直连版 (v4.3.0)：
  - 苹果全生态 (Apple/iCloud/App Store/CDN/iTunes) 绝对置顶 DIRECT 直连，测速 12ms；
  - Google / OpenAI / ChatGPT / Codex 全生态强制走“🚀节点选择”；
  - 企航教育/国内流媒体/国内网站极速直连；
  - 手机端与电脑端规则 100% 严格对齐。
author: YJTDW
homepage: "https://github.com/YJTDW/my-shadowrocket-rules"
date: "2026-08-20"
version: "4.3.0"

mode: rule
ipv6: false

dns:
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  nameserver: #!replace
    - "https://dns.alidns.com/dns-query"
    - "https://doh.pub/dns-query"
  follow-rule: false
  skip-cert-verify: false
  fake-ip-filter: #!replace
    - "*.lan"
    - "+.local"
    - "+.localhost"
    - "+.home.arpa"
    - "captive.apple.com"
    - "time.*.com"
    - "time.*.gov"
    - "time.*.edu.cn"
    - "time.*.apple.com"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"

# Block QUIC so HTTP/3 falls back to TCP and follows the selected proxy path.
script:
  shortcuts:
    merged-quic: "network == 'udp' and dst_port == 443"

rules: #!replace
  # ==================== [0. 局域网与内网直连] ====================
  - "DOMAIN-SUFFIX,local,DIRECT"
  - "DOMAIN-SUFFIX,localhost,DIRECT"
  - "DOMAIN-SUFFIX,lan,DIRECT"
  - "DOMAIN-SUFFIX,home.arpa,DIRECT"
  - "DOMAIN,captive.apple.com,DIRECT"
  - "IP-CIDR,0.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve"
  - "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve"
  - "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,224.0.0.0/4,DIRECT,no-resolve"

  # ==================== [1. 拦截 QUIC (UDP 443) 协议] ====================
  - "SCRIPT,merged-quic,REJECT,no-track"

  # ==================== [2. 苹果全家桶 100% 绝对纯直连 (置顶保障 12ms 秒连)] ====================
  - "DOMAIN-KEYWORD,apple,DIRECT"
  - "DOMAIN-KEYWORD,icloud,DIRECT"
  - "DOMAIN-KEYWORD,itunes,DIRECT"
  - "DOMAIN-KEYWORD,mzstatic,DIRECT"
  - "DOMAIN-KEYWORD,aaplimg,DIRECT"
  - "DOMAIN-SUFFIX,apple.com,DIRECT"
  - "DOMAIN-SUFFIX,apple.co,DIRECT"
  - "DOMAIN-SUFFIX,appstore.com,DIRECT"
  - "DOMAIN-SUFFIX,icloud.com,DIRECT"
  - "DOMAIN-SUFFIX,icloud-content.com,DIRECT"
  - "DOMAIN-SUFFIX,itunes.apple.com,DIRECT"
  - "DOMAIN-SUFFIX,apps.apple.com,DIRECT"
  - "DOMAIN-SUFFIX,cdn-apple.com,DIRECT"
  - "DOMAIN-SUFFIX,mzstatic.com,DIRECT"
  - "DOMAIN-SUFFIX,aaplimg.com,DIRECT"
  - "DOMAIN-SUFFIX,swcdn.apple.com,DIRECT"
  - "DOMAIN-SUFFIX,me.com,DIRECT"
  - "DOMAIN-SUFFIX,apple-cloudkit.com,DIRECT"
  - "DOMAIN-SUFFIX,apple-livephotoskit.com,DIRECT"
  - "DOMAIN-SUFFIX,apple-mapkit.com,DIRECT"
  - "GEOSITE,apple,DIRECT"

  # ==================== [3. Google 全生态强制走节点] ====================
  - "GEOSITE,google,🚀节点选择"
  - "DOMAIN-KEYWORD,google,🚀节点选择"
  - "DOMAIN-KEYWORD,youtube,🚀节点选择"
  - "DOMAIN-SUFFIX,1e100.net,🚀节点选择"
  - "DOMAIN-SUFFIX,android.com,🚀节点选择"
  - "DOMAIN-SUFFIX,appspot.com,🚀节点选择"
  - "DOMAIN-SUFFIX,blogger.com,🚀节点选择"
  - "DOMAIN-SUFFIX,blogspot.com,🚀节点选择"
  - "DOMAIN-SUFFIX,firebaseapp.com,🚀节点选择"
  - "DOMAIN-SUFFIX,firebaseio.com,🚀节点选择"
  - "DOMAIN-SUFFIX,ggpht.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gstatic.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gvt0.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gvt1.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gvt2.com,🚀节点选择"
  - "DOMAIN-SUFFIX,gvt3.com,🚀节点选择"
  - "DOMAIN-SUFFIX,kaggle.com,🚀节点选择"
  - "DOMAIN-SUFFIX,recaptcha.net,🚀节点选择"
  - "DOMAIN-SUFFIX,waze.com,🚀节点选择"
  - "DOMAIN-SUFFIX,widevine.com,🚀节点选择"
  - "DOMAIN-SUFFIX,withgoogle.com,🚀节点选择"
  - "DOMAIN-SUFFIX,youtu.be,🚀节点选择"
  - "DOMAIN-SUFFIX,yt.be,🚀节点选择"
  - "DOMAIN-SUFFIX,ytimg.com,🚀节点选择"

  # ==================== [4. OpenAI / ChatGPT / Codex 全生态强制走节点] ====================
  - "GEOSITE,openai,🚀节点选择"
  - "DOMAIN-KEYWORD,openai,🚀节点选择"
  - "DOMAIN-KEYWORD,chatgpt,🚀节点选择"
  - "DOMAIN-SUFFIX,livekit.cloud,🚀节点选择"
  - "DOMAIN,client-api.arkoselabs.com,🚀节点选择"
  - "DOMAIN,openai-api.arkoselabs.com,🚀节点选择"
  - "DOMAIN,challenges.cloudflare.com,🚀节点选择"
  - "DOMAIN-KEYWORD,workos,🚀节点选择"

  # ==================== [5. 企航网校/国内学习直播极速直连] ====================
  - "DOMAIN-SUFFIX,iqihang.com,DIRECT"
  - "DOMAIN-SUFFIX,iqihangedu.com.cn,DIRECT"
  - "DOMAIN-SUFFIX,qihang.com.cn,DIRECT"
  - "DOMAIN-SUFFIX,vipqihang.com,DIRECT"
  - "DOMAIN-SUFFIX,polyv.net,DIRECT"
  - "DOMAIN-SUFFIX,videocc.net,DIRECT"
  - "DOMAIN-SUFFIX,alicdn.com,DIRECT"
  - "DOMAIN,iqh-zt.oss-cn-beijing.aliyuncs.com,DIRECT"

  # ==================== [6. 广告拦截] ====================
  - "GEOSITE,category-ads-all,REJECT"

  # ==================== [7. 中国大陆域名与 IP 极速直连] ====================
  - "DOMAIN-SUFFIX,cn,DIRECT"
  - "DOMAIN-SUFFIX,xn--fiqs8s,DIRECT"
  - "DOMAIN-SUFFIX,xn--fiqz9s,DIRECT"
  - "DOMAIN-SUFFIX,xn--55qx5d,DIRECT"
  - "DOMAIN-SUFFIX,xn--io0a7i,DIRECT"
  - "DOMAIN-SUFFIX,xn--zfr164b,DIRECT"
  - "DOMAIN-SUFFIX,xn--55qw42g,DIRECT"
  - "GEOSITE,cn,DIRECT"
  - "GEOIP,CN,DIRECT,no-resolve"

  # ==================== [8. 其余全量流量走节点] ====================
  - "MATCH,🚀节点选择"
