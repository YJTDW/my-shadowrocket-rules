# Stash universal dynamic smart-exit override.
# Enable Stash-All-in-One.stoverride above this override.
# This file never snapshots an airport's node names.

name: "通用智能出口（动态读取当前机场）"
desc: |-
  通过 include-all 动态读取当前启用配置的全部代理。
  普通节点保持普通出口；只有在“🚀通用节点选择”中选中“🚀智能出口”时，
  才会自动优选前置节点并经洛杉矶固定出口。
author: YJTDW
homepage: "https://github.com/YJTDW/my-shadowrocket-rules"
date: "2026-07-28"
version: "3.0.0"

external-controller: "127.0.0.1:9090"

# The leading section sign is an internal sentinel. The include-all groups
# exclude names beginning with this character, preventing a dialer loop.
proxies:
  - name: "§🏁智能链固定落地"
    type: socks5
    server: "207.97.139.109"
    port: 443
    username: "fXaEWJpRKeAp"
    password: "eTzA9SVbZ1"
    udp: true
    dialer-proxy: "🎛智能链前置"
    benchmark-url: "http://www.apple.com/library/test/success.html"
    benchmark-timeout: 5

# Do not replace the airport's original proxy-groups. These four uniquely
# named groups are inserted in front and populate from the active profile.
proxy-groups:
  - name: "🚀通用节点选择"
    type: select
    proxies:
      - "🚀智能出口"
    include-all: true
    filter: "^[^§]"

  - name: "🚀智能出口"
    type: select
    proxies:
      - "§🏁智能链固定落地"

  - name: "🎛智能链前置"
    type: select
    proxies:
      - "⚡智能链低延迟"
    include-all: true
    filter: "^[^§]"

  - name: "⚡智能链低延迟"
    type: url-test
    include-all: true
    filter: "^[^§]"
    url: "http://www.apple.com/library/test/success.html"
    interval: 300
    tolerance: 50
    lazy: false

# Stash-All-in-One supplies merged-quic and the merged-* rule providers.
# Replacing only the rule targets keeps its DNS/leak protections while routing
# proxied traffic through the universal selector instead of an airport-specific
# “🚀节点选择” group.
rules: #!replace
  - "DOMAIN-SUFFIX,local,DIRECT"
  - "DOMAIN-SUFFIX,localhost,DIRECT"
  - "DOMAIN-SUFFIX,lan,DIRECT"
  - "DOMAIN-SUFFIX,home.arpa,DIRECT"
  - "DOMAIN,captive.apple.com,DIRECT"
  - "IP-CIDR,0.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve"
  - "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve"
  - "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve"
  - "IP-CIDR,224.0.0.0/4,DIRECT,no-resolve"
  - "SCRIPT,merged-quic,REJECT,no-track"
  - "DOMAIN-SUFFIX,apple-relay.apple.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,apple-relay.cloudflare.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,apple-relay.akamaized.net,🚀通用节点选择"
  - "DOMAIN-SUFFIX,chatgpt.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,openai.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,chat.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,sora.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,oaistatic.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,oaiusercontent.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,openaiapi-site.azureedge.net,🚀通用节点选择"
  - "DOMAIN-SUFFIX,chatgpt.livekit.cloud,🚀通用节点选择"
  - "DOMAIN-SUFFIX,copilot.microsoft.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,google.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,googleapis.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,gstatic.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,youtube.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,youtu.be,🚀通用节点选择"
  - "DOMAIN-SUFFIX,telegram.org,🚀通用节点选择"
  - "DOMAIN-SUFFIX,t.me,🚀通用节点选择"
  - "DOMAIN-SUFFIX,x.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,twitter.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,facebook.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,instagram.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,dnsleaktest.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,ipleak.net,🚀通用节点选择"
  - "DOMAIN-SUFFIX,browserleaks.com,🚀通用节点选择"
  - "DOMAIN-SUFFIX,whoer.net,🚀通用节点选择"
  - "RULE-SET,merged-proxy-domain,🚀通用节点选择"
  - "RULE-SET,merged-tld-not-cn,🚀通用节点选择"
  - "RULE-SET,merged-proxy-classical,🚀通用节点选择"
  - "DOMAIN-SUFFIX,apple.com,DIRECT"
  - "DOMAIN-SUFFIX,icloud.com,DIRECT"
  - "DOMAIN-SUFFIX,cdn-apple.com,DIRECT"
  - "DOMAIN-SUFFIX,mzstatic.com,DIRECT"
  - "RULE-SET,merged-cn-domain,DIRECT"
  - "DOMAIN-SUFFIX,cn,DIRECT"
  - "DOMAIN-SUFFIX,xn--fiqs8s,DIRECT"
  - "DOMAIN-SUFFIX,xn--fiqz9s,DIRECT"
  - "DOMAIN-SUFFIX,xn--55qx5d,DIRECT"
  - "DOMAIN-SUFFIX,xn--io0a7i,DIRECT"
  - "DOMAIN-SUFFIX,xn--zfr164b,DIRECT"
  - "DOMAIN-SUFFIX,xn--55qw42g,DIRECT"
  - "GEOSITE,cn,DIRECT"
  - "RULE-SET,merged-cn-classical,DIRECT"
  - "RULE-SET,merged-cn-ip,DIRECT"
  - "GEOIP,CN,DIRECT,no-resolve"
  - "GEOSITE,category-ads-all,REJECT"
  - "NETWORK,udp,🚀通用节点选择"
  - "GEOSITE,geolocation-!cn,🚀通用节点选择"
  - "MATCH,🚀通用节点选择"

script-providers:
  智能出口综合测速:
    url: "https://raw.githubusercontent.com/YJTDW/my-shadowrocket-rules/main/Stash-Chain-Auto-Speed.js"
    interval: 86400
    headers:
      Accept: "application/javascript,text/plain,*/*"

tiles:
  - name: 智能出口综合测速
    interval: 21600
    argument: '{"frontGroup":"🎛智能链前置","autoGroup":"⚡智能链低延迟","exitProxy":"§🏁智能链固定落地","triggerGroup":"🚀通用节点选择","triggerValue":"🚀智能出口"}'
    title: "智能出口等待启用"
    content: "先在通用节点选择中选中智能出口"
    icon: "gauge.with.dots.needle.67percent"
    backgroundColor: "#2563EB"

cron:
  script:
    - name: 智能出口综合测速
      cron: "5 */6 * * *"
      argument: '{"frontGroup":"🎛智能链前置","autoGroup":"⚡智能链低延迟","exitProxy":"§🏁智能链固定落地","triggerGroup":"🚀通用节点选择","triggerValue":"🚀智能出口"}'
      timeout: 180
