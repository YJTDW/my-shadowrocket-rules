script-providers:
  智能出口综合测速:
    url: https://raw.githubusercontent.com/YJTDW/my-shadowrocket-rules/main/Stash-Chain-Auto-Speed.js
    interval: 86400
    headers:
      Accept: application/javascript,text/plain,*/*
tiles:
- name: 智能出口综合测速
  interval: 21600
  argument: '{"frontGroup":"🎛智能链前置","autoGroup":"⚡智能链低延迟","exitProxy":"🏁智能链固定落地","triggerGroup":"🚀节点选择","triggerValue":"🚀智能出口"}'
  title: 智能出口等待启用
  content: 先在节点选择中选中智能出口
  icon: gauge.with.dots.needle.67percent
  backgroundColor: '#2563EB'
cron:
  script:
  - name: 智能出口综合测速
    cron: 5 */6 * * *
    argument: '{"frontGroup":"🎛智能链前置","autoGroup":"⚡智能链低延迟","exitProxy":"🏁智能链固定落地","triggerGroup":"🚀节点选择","triggerValue":"🚀智能出口"}'
    timeout: 180
