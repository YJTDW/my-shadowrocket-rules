# Stash Override (YAML)
# 企业级跨平台客户端与服务端标准配置 - Stash 通用终极覆写 (全面对齐 sing-box 架构)
# 仅适用于当前最终保留的六个节点，保留子策略组入口。

name: "VPS 正式版 · 按地区排序"
desc: |-
  【全面看齐 sing-box 架构与策略组规范】
  1. 当前最终六个节点与合一订阅保持一致；替换原正式覆写使用。
  2. 4 大核心策略组：🤖 AI平台、📺 YouTube、🚀节点选择、♻️自动选择 (Apple 官方低延迟测速)。
  3. 铁壁防泄露：全域拦截 WebRTC / STUN / TURN 探测 (UDP 3478-3481/19302/19305/5349)，精准放行 OpenAI LiveKit 官方语音。
  4. Fake-IP 域名透传：开启 198.18.0.1/16 虚拟地址池，国内/Apple 白名单真实 IP 直连，海外与 AI 域名 100% 透传防真实 IP 泄露。
  5. DNS 智能分流：阿里/腾讯 DoH 国内直连，Google/Cloudflare DoH 节点代理解析。
  6. QUIC 拦截：拦截 UDP 443，强制降级走高性能 TCP TLS 1.3 隧道。
author: YJTDW
homepage: "https://github.com/YJTDW/my-shadowrocket-rules"
date: "2026-09-14"
version: "3.7.0"
mode: rule
ipv6: false

tun:
  enable: true
  stack: mixed
  mtu: 1400
  auto-route: true
  strict-route: true

proxy-groups: #!replace
- name: 🚀节点选择
  type: select
  proxies:
  - ♻️自动选择
  - DMIT-Reality-IPv4
  - DMIT-Reality-IPv6
  - ISVORO-HKLite-HY2-IPv6
  - Skyline-SG-HY2-IPv6
  - HK-Lumen-SS2022-IPv6
  - Skyline-SG-家宽-HY2
  - DIRECT
- name: ♻️自动选择
  type: url-test
  url: http://www.apple.com/library/test/success.html
  interval: 900
  tolerance: 3
  lazy: true
  proxies:
  - DMIT-Reality-IPv4
  - DMIT-Reality-IPv6
  - ISVORO-HKLite-HY2-IPv6
  - Skyline-SG-HY2-IPv6
  - HK-Lumen-SS2022-IPv6
  - Skyline-SG-家宽-HY2
- name: 📺 YouTube
  type: select
  proxies:
  - 🚀节点选择
  - ♻️自动选择
  - DMIT-Reality-IPv4
  - DMIT-Reality-IPv6
  - ISVORO-HKLite-HY2-IPv6
  - Skyline-SG-HY2-IPv6
  - HK-Lumen-SS2022-IPv6
  - Skyline-SG-家宽-HY2
- name: 🤖 AI平台
  type: select
  proxies:
  - 🚀节点选择
  - ♻️自动选择
  - DMIT-Reality-IPv4
  - DMIT-Reality-IPv6
  - ISVORO-HKLite-HY2-IPv6
  - Skyline-SG-HY2-IPv6
  - HK-Lumen-SS2022-IPv6
  - Skyline-SG-家宽-HY2

dns: #!replace
  follow-rule: true
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  proxy-server-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  nameserver: #!replace
    - "https://dns.alidns.com/dns-query"
    - "https://doh.pub/dns-query"
  fallback: #!replace
    - "https://dns.google/dns-query"
    - "https://cloudflare-dns.com/dns-query"
  fallback-filter: #!replace
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4
  fake-ip-filter: #!replace
    - "*.lan"
    - "*.local"
    - "*.arpa"
    - "time.*"
    - "ntp.*"
    - "+.pool.ntp.org"
    - "localhost"
    - "+.home.arpa"
    - "*.apple.com"
    - "*.apple.co"
    - "*.appstore.com"
    - "*.icloud.com"
    - "*.icloud-content.com"
    - "*.cdn-apple.com"
    - "*.mzstatic.com"
    - "*.aaplimg.com"
    - "*.swcdn.apple.com"
    - "*.me.com"
    - "*.apple-cloudkit.com"
    - "*.apple-livephotoskit.com"
    - "*.apple-mapkit.com"
    - "captive.apple.com"
    - "*.wechat.com"
    - "*.weixin.com"
    - "*.servicewechat.com"
    - "*.qq.com"
    - "*.qpic.cn"
    - "*.qlogo.cn"
    - "*.gtimg.com"
    - "*.cn"
    - "*.xn--fiqs8s"
    - "*.xn--fiqz9s"
    - "*.xn--55qx5d"
    - "*.xn--io0a7i"
    - "*.xn--zfr164b"
    - "*.xn--55qw42g"
    - "*.qihangjiaoyu.com"
    - "*.polyv.net"
    - "*.polyv.cn"
    - "*.alicdn.com"
    - "*.msftncsi.com"
    - "*.msftconnecttest.com"
  nameserver-policy: #!replace
    "geosite:apple":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.apple.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.icloud.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.icloud-content.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.appstore.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.cdn-apple.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.mzstatic.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.aaplimg.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.me.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "geosite:cn":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.cn":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.qq.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.weixin.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.wechat.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.servicewechat.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.qpic.cn":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.qlogo.cn":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.gtimg.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.qihangjiaoyu.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.polyv.net":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.polyv.cn":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "+.alicdn.com":
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "geosite:geolocation-!cn":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "geosite:gfw":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "geosite:google":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "geosite:openai":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.google.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.googleapis.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.googleusercontent.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.openai.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.chatgpt.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.oaistatic.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.oaiusercontent.com":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
    "+.livekit.cloud":
      - "https://dns.google/dns-query"
      - "https://cloudflare-dns.com/dns-query"
  skip-cert-verify: false

script:
  shortcuts:
    merged-quic: "network == 'udp' and dst_port == 443"
    webrtc-ports: "network == 'udp' and dst_port >= 3478 and dst_port <= 3481"
    webrtc-turn-tls: "network == 'udp' and dst_port == 5349"

