# Private Stash add-on override.
# Enable together with Stash-All-in-One.stoverride.
# The injected proxy automatically appears in “🚀 Stash 节点选择”
# because that group uses include-all.

name: "新增私密固定出口"
desc: |-
  在三合一复写上新增一个固定 SOCKS5 出口。
  前置使用机场现有“♻️自动选择”，自动选择延迟最低的机场节点。
date: "2026-07-28"
version: "1.0.0"

proxies:
  - name: "🔗固定出口链"
    type: socks5
    server: "207.97.139.109"
    port: 443
    username: "fXaEWJpRKeAp"
    password: "eTzA9SVbZ1"
    udp: true
    dialer-proxy: "♻️自动选择"
    benchmark-url: "http://www.apple.com/"
    benchmark-timeout: 5
